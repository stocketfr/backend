DATABASE_URL=""
NODE_ENV="development"
PORT=8080
TENANT_BASE_DOMAIN=stocket.fr
PLATFORM_HOST=app.stocket.fr
CORS_ORIGIN=http://localhost:3000
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
# Used once when a fresh database is initialized.
SUPERADMIN_EMAIL=admin@stocket.fr
SUPERADMIN_NAME="Stocket Admin"
SUPERADMIN_PASSWORD=""
SUPERADMIN_PASSWORD_HASH=""
# Leave RESEND_API_KEY empty in dev: emails are printed to the backend logs
# (console transport) instead of being sent. Required in production.
RESEND_API_KEY=""
EMAIL_FROM="Stocket <no-reply@mail.stocket.fr>"
# Logging defaults to the compact text format. Production infrastructure uses
# JSON so collectors such as Datadog can index request and domain fields.
LOG_FORMAT=text
# Optional Smart Import AI proposal layer. When OPENAI_API_KEY is empty, the
# importer falls back to deterministic rule-based proposals.
OPENAI_API_KEY=""
OPENAI_BASE_URL=https://api.openai.com/v1
PRODUCT_IMPORT_LLM_ENABLED=true
PRODUCT_IMPORT_LLM_MODEL=gpt-5-mini
PRODUCT_IMPORT_LLM_TIMEOUT_MS=15000
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio123
S3_BUCKET=stocket-local
S3_FORCE_PATH_STYLE=true
# Optional background worker tuning. Defaults are shown.
BACKGROUND_TASK_CONCURRENCY=4
BACKGROUND_TASK_LEASE_MS=60000
BACKGROUND_TASK_HEARTBEAT_MS=15000
BACKGROUND_TASK_POLL_MS=1000
BACKGROUND_TASK_RECOVERY_MS=30000
BACKGROUND_TASK_RETRY_DELAY_MS=30000
BACKGROUND_TASK_PROGRESS_THROTTLE_MS=500
